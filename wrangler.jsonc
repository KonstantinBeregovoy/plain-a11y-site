{
  // Cloudflare Workers with static assets: serves ./public as it is, there is no build step.
  // "name" must match the Worker name in the Cloudflare dashboard.
  "name": "plain-a11y-site",
  "compatibility_date": "2026-10-14",
  // The site lives on its own domain (set in the dashboard under Domains & Routes), so the
  // workers.dev address and the per-branch preview addresses stay off.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "a11y-ext.bereg.dev", "custom_domain": true }],
  "assets": {
    "directory": "./public",
    // Unknown URLs get public/404.html with a 404 status.
    "not_found_handling": "404-page"
  }
}
